{
  "name": "afya-drop",
  "version": "0.1.0",
  "private": true,
  "description": "Afya Drop — AI layer for Afya-Links. Supabase + Vercel + Railway.",
  "workspaces": [
    "services/*",
    "web/*"
  ],
  "scripts": {
    "dev:ai": "npm run dev -w services/ai-service",
